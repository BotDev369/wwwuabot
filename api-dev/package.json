{
  "name": "wwwuabot-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@sentry/cloudflare": "^10.74.0",
    "@wwwuabot/shared": "*",
    "zod": "^4.6.5"
