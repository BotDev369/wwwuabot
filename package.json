{
  "name": "wwwuabot",
  "private": true,
  "workspaces": [
    "packages/*",
    "bot-dev",
    "api-dev",
    "web-platform-dev",
    "web-admin-dev"
  ],
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "lint": "eslint . && npm run lint --workspaces --if-present",
    "lint:fix": "eslint . --fix && npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:css": "node scripts/check-css-classes.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:db": "node scripts/check-db.mjs",
    "doc:api": "node scripts/doc-api.mjs",
    "check:quality": "node scripts/check-quality.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:coverage": "vitest run --coverage",
    "check:coverage": "node scripts/check-coverage.mjs",
    "clean:tmp": "node scripts/clean-tmp.mjs"
  }
}
