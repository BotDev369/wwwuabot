{
  "name": "wwwuabot",
  "version": "1.0.0",
  "description": "Professional Telegram Bot on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env production",
    "tail:dev": "wrangler tail --env dev",
    "tail:prod": "wrangler tail --env production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "telegram",
    "bot",
    "cloudflare",
    "workers"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "grammy": "^1.45.1",
    "@wwwuabot/shared": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "wrangler": "^4.110.0"
  }
}
