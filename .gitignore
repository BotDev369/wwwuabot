# Dependencies
node_modules/

# Lockfiles in sub-packages (enforce single root package-lock.json in monorepo)
packages/*/*lock*
*-dev/*lock*
*.lock
!package-lock.json

# Environment files
.env
.env.local
*.env.*

# Build/dist directories
*-dev/dist/
packages/*/dist/
bot/dist/
api/dist/
web/dist/
web-admin/dist/

# Cloudflare local state
.wrangler/

# TypeScript build info
*.tsbuildinfo

# Logs
*.log
*.tmp

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Compression files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
